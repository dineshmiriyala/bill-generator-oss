# Bill Generator — environment variable reference
# Copy this to a file your launcher sources, or pass values inline.
# Every var is optional; defaults are noted.

# --- Branding ---------------------------------------------------------------
# Display name in window title, logs, packaging metadata.
BG_APP_NAME="Bill Generator"
# Prefix for invoice IDs: e.g. INV-280526-00042
BG_INVOICE_PREFIX="INV"
# Prefix for accounting transaction IDs: e.g. TXN-280526-000001
BG_TXN_PREFIX="TXN"
# Override the version string baked in at runtime.
# BG_APP_VERSION="4.5.1"

# --- Networking -------------------------------------------------------------
# Default 127.0.0.1 (loopback only). Setting 0.0.0.0 exposes the app to
# the LAN — there is no auth or CSRF protection, so don't do this on
# untrusted networks. See SECURITY.md.
BG_BIND_HOST="127.0.0.1"

# --- Secrets ----------------------------------------------------------------
# Optional: provide your own Flask SECRET_KEY. If unset, the app
# generates and persists a random one under DATA_DIR/secret.key.
# SECRET_KEY="change-me-please"

# --- Desktop packaging ------------------------------------------------------
# Set to "1" to use the OS-specific data directory instead of ./db.
# Already set automatically by desktop_launcher.py.
# BG_DESKTOP="1"
